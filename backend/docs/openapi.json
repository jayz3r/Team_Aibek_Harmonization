  "components": {
    "schemas": {
      "Area": {
        "properties": {
          "bbox": {
            "anyOf": [
              {
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "type": "array",
                "maxItems": 4,
                "minItems": 4
              },
              {
                "type": "null"
              }
            ],
            "title": "Bbox",
            "description": "[west, south, east, north], WGS84. No antimeridian crossing."
          },
          "polygon": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Polygon",
            "description": "GeoJSON Polygon or MultiPolygon geometry, [longitude, latitude]."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Area"
      },
      "Body_upload_api_v1_datasets_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "FIRMS CSV or ZIP (MAX_UPLOAD_MB, default 256 MiB)"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_api_v1_datasets_upload_post"
      },
      "CalendarQuery": {
        "properties": {
          "area": {
            "$ref": "#/components/schemas/Area"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "daynight": {
            "type": "string",
            "enum": [
              "D",
              "N",
              "both"
            ],
            "title": "Daynight",
            "default": "D"
          },
          "processing": {
            "type": "string",
            "enum": [
              "archive",
              "NRT",
              "RT",
              "URT",
              "unknown"
            ],
            "title": "Processing",
            "default": "archive"
          },
          "hotspot_scope": {
            "type": "string",
            "enum": [
              "all",
              "vegetation"
            ],
            "title": "Hotspot Scope",
            "default": "all"
          },
          "model_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Id"
          },
          "platform": {
            "type": "string",
            "enum": [
              "auto",
              "Terra",
              "Aqua",
              "SNPP",
              "NOAA20",
              "NOAA21"
            ],
            "title": "Platform",
            "default": "auto"
          },
          "allow_extrapolation": {
            "type": "boolean",
            "title": "Allow Extrapolation",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "CalendarQuery"
      },
      "CalibrationRequest": {
        "properties": {
          "area": {
            "$ref": "#/components/schemas/Area"
          },
          "reference": {
            "type": "string",
            "enum": [
              "Terra",
              "Aqua",
              "SNPP",
              "NOAA20",
              "NOAA21"
            ],
            "title": "Reference",
            "default": "SNPP"
          },
          "train_start_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2000.0,
            "title": "Train Start Year",
            "default": 2013
          },
          "train_end_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2001.0,
            "title": "Train End Year",
            "default": 2024
          },
          "test_year": {
            "type": "integer",
            "maximum": 2100.0,
            "minimum": 2002.0,
            "title": "Test Year",
            "default": 2025
          },
          "hotspot_scope": {
            "type": "string",
            "enum": [
              "all",
              "vegetation"
            ],
            "title": "Hotspot Scope",
            "default": "all"
          },
          "min_train_rows": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 3.0,
            "title": "Min Train Rows",
            "default": 24
          },
          "bootstrap_samples": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 30.0,
            "title": "Bootstrap Samples",
            "default": 200
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "CalibrationRequest"
      },
      "DetectionQuery": {
        "properties": {
          "area": {
            "$ref": "#/components/schemas/Area"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "daynight": {
            "type": "string",
            "enum": [
              "D",
              "N",
              "both"
            ],
            "title": "Daynight",
            "default": "D"
          },
          "processing": {
            "type": "string",
            "enum": [
              "archive",
              "NRT",
              "RT",
              "URT",
              "unknown"
            ],
            "title": "Processing",
            "default": "archive"
          },
          "hotspot_scope": {
            "type": "string",
            "enum": [
              "all",
              "vegetation"
            ],
            "title": "Hotspot Scope",
            "default": "all"
          },
          "platforms": {
            "items": {
              "type": "string",
              "enum": [
                "Terra",
                "Aqua",
                "SNPP",
                "NOAA20",
                "NOAA21"
              ]
            },
            "type": "array",
            "maxItems": 5,
            "title": "Platforms"
          },
          "quality_only": {
            "type": "boolean",
            "title": "Quality Only",
            "default": true
          },
          "limit": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 1000
          },
          "offset": {
            "type": "integer",
            "maximum": 10000000.0,
            "minimum": 0.0,
            "title": "Offset",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "DetectionQuery"
      },
      "FirmsRequest": {
        "properties": {
          "source": {
            "type": "string",
            "enum": [
              "MODIS_NRT",
              "MODIS_SP",
              "VIIRS_SNPP_NRT",
              "VIIRS_SNPP_SP",
              "VIIRS_NOAA20_NRT",
              "VIIRS_NOAA20_SP",
              "VIIRS_NOAA21_NRT",
              "VIIRS_NOAA21_SP"
            ],
            "title": "Source"
          },
          "area": {
            "$ref": "#/components/schemas/Area"
          },
          "start": {
            "anyOf": [
              {
                "type": "string",
                "format": "date"
              },
              {
                "type": "null"
              }
            ],
            "title": "Start"
          },
          "days": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Days",
            "default": 1
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "area"
        ],
        "title": "FirmsRequest"
      },
      "GridQuery": {
        "properties": {
          "area": {
            "$ref": "#/components/schemas/Area"
          },
          "start": {
            "type": "string",
            "format": "date",
            "title": "Start"
          },
          "end": {
            "type": "string",
            "format": "date",
            "title": "End"
          },
          "daynight": {
            "type": "string",
            "enum": [
              "D",
              "N",
              "both"
            ],
            "title": "Daynight",
            "default": "D"
          },
          "processing": {
            "type": "string",
            "enum": [
              "archive",
              "NRT",
              "RT",
              "URT",
              "unknown"
            ],
            "title": "Processing",
            "default": "archive"
          },
          "hotspot_scope": {
            "type": "string",
            "enum": [
              "all",
              "vegetation"
            ],
            "title": "Hotspot Scope",
            "default": "all"
          },
          "platform": {
            "type": "string",
            "enum": [
              "Terra",
              "Aqua",
              "SNPP",
              "NOAA20",
              "NOAA21"
            ],
            "title": "Platform",
            "default": "SNPP"
          },
          "limit": {
            "type": "integer",
            "maximum": 20000.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 5000
          },
          "offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Offset",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "start",
          "end"
        ],
        "title": "GridQuery"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
