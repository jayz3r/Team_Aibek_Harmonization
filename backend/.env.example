# Copy to backend/.env. The server (uvicorn app.main:app), scripts/demo.py and the CLI read this file;
# real environment variables always win. Tests never read it.

# Local demo: empty key. Set a strong key before making the service accessible outside localhost.
API_KEY=

# Free NASA FIRMS MAP_KEY (https://firms.modaps.eosdis.nasa.gov/api/map_key/) enables "Live FIRMS import".
# It stays on the server; never put it into the frontend.
FIRMS_MAP_KEY=

# Browser origins allowed to call the API directly. Not needed when the UI is opened through
# the Vite dev proxy (npm run dev) or served by this backend after `npm run build`.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:3000

# Where the DuckDB file lives (relative to the folder you start the server from).
DATA_DIR=data

# Built frontend to serve at "/". Default: ../frontend/dist. Leave blank to disable.
# FRONTEND_DIST=

# ---- Optional tuning --------------------------------------------------------------------------
# Largest accepted upload, MiB (default 256).
# MAX_UPLOAD_MB=256
# Rows parsed per step and DuckDB memory. Left unset they are chosen from the container's RAM
# (512 MB host -> 25000 rows, about 200MB; a normal computer -> 100000 rows, 3GB).
# CHUNK_ROWS=25000
# DUCKDB_MEMORY_LIMIT=200MB
# 1 = when the database is empty at start-up, import the bundled sample and fit a model
# (for hosts that wipe the disk on restart, e.g. Render Free).
# AUTOLOAD_DEMO=1
